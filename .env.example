# ─────────────────────────────────────────────────────────────────
# Distribution Tracker v2.3.0 — Configuration
# Copier ce fichier en .env et adapter les valeurs
# ─────────────────────────────────────────────────────────────────

# Port d'écoute du serveur
PORT=3000

# ── Compte admin initial ───────────────────────────────────────────
# Synchronisé à CHAQUE démarrage : toujours source de vérité.
# Changer le mot de passe après la première connexion.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123

# ── Sécurité JWT ───────────────────────────────────────────────────
# Clé secrète pour signer les tokens JWT.
# OBLIGATOIRE : le serveur refuse de démarrer si cette variable est absente.
# Générer une valeur aléatoire :
#   openssl rand -hex 32
JWT_SECRET=

# ── URL publique ───────────────────────────────────────────────────
# URL complète de l'application, sans slash final.
# Utilisée pour :
#   - Générer les QR codes
#   - Les liens de réinitialisation de mot de passe par email
#   - L'URI de redirection OAuth2 SSO (ex: https://distrib.mondomaine.fr/api/auth/sso/callback)
# IMPORTANT pour le SSO : doit être l'URL publique exacte déclarée dans Synology SSO Server.
# Laisser vide en développement local (auto-détecté).
BASE_URL=http://localhost:3000

# ── SMTP — validation TLS ──────────────────────────────────────────
# Par défaut, le certificat TLS du serveur SMTP est vérifié (sécurisé).
# Mettre à "false" UNIQUEMENT pour les serveurs SMTP internes avec certificat
# auto-signé (ex : serveur mail Synology sur réseau local).
# SMTP_REJECT_UNAUTHORIZED=false

# ── Stockage ───────────────────────────────────────────────────────
# Répertoire de la base SQLite dans le container Docker.
# Monter un volume ou bind mount sur ce chemin pour la persistance.
DATA_DIR=/data
