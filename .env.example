# ─────────────────────────────────────────────────
# Distribution Tracker — Configuration
# Copier ce fichier en .env et adapter les valeurs
# ─────────────────────────────────────────────────

# Port d'écoute du serveur
PORT=3000

# Mot de passe de l'interface admin
# IMPORTANT : changer cette valeur en production !
ADMIN_PASSWORD=admin123

# URL publique complète de l'application (sans slash final)
# Utilisée pour générer les QR codes et les liens de partage
# Laisser vide en développement local (auto-détecté)
BASE_URL=http://localhost:3000

# Répertoire de stockage de la base de données SQLite
# En Docker : monter un volume sur ce chemin
DATA_DIR=./data
